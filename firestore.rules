rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to submit feedback (create only) - temporarily allow without strict auth
    match /feedback/{document} {
      allow create: if true; // Allow feedback submission for now
      allow read: if false; // No reading of individual feedback for privacy
      allow update, delete: if false; // No updates or deletes allowed
    }

    // Allow admin to read feedback (for analytics/reporting)
    match /feedback/{document} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}